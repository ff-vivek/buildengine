# Environment Configuration for BuildEngine Server
# Copy this file to .env and modify the values as needed

# Storage Configuration
# Options: 'local' or 'gcp' (default: 'local')
STORAGE_TYPE=local

# Local Storage Configuration (used when STORAGE_TYPE=local)
LOCAL_STORAGE_PATH=storage

# Google Cloud Storage Configuration (used when STORAGE_TYPE=gcp)
GCP_PROJECT_ID=your-project-id
GCP_BUCKET_NAME=buildengine-storage
# Either provide a path to service account JSON file:
GCP_SERVICE_ACCOUNT_PATH=/path/to/service-account.json
# Or provide the service account JSON content directly:
# GCP_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"..."}

# Server Configuration
BASE_URL=http://localhost:8788
ENVIRONMENT=development

# Example for Google Cloud Storage:
# STORAGE_TYPE=gcp
# GCP_PROJECT_ID=my-buildengine-project
# GCP_BUCKET_NAME=buildengine-artifacts
# GCP_SERVICE_ACCOUNT_PATH=/path/to/service-account.json
# BASE_URL=https://my-buildengine-server.com
# ENVIRONMENT=production
